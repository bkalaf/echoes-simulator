{
  "name": "@echoes/simulator",
  "version": "0.1.0",
  "private": true,
  "author": "Echoes of Eidolon",
  "type": "module",
  "description": "Standalone deterministic historical simulator for Echoes of Eidolon",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "pnpm build && electron .",
    "build:renderer": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "build": "pnpm build:node && pnpm build:renderer",
    "package": "pnpm canonical:verify && pnpm build && electron-builder --dir",
    "package:offline": "pnpm canonical:verify && pnpm build && node scripts/package-offline.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "pnpm typecheck && node scripts/check-engine-randomness.mjs && pnpm audit:v5",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "pnpm canonical:verify && pnpm lint && pnpm test && pnpm test:integration && pnpm build",
    "preflight:real": "pnpm build:node && node dist-electron/src/scripts/real-preflight.js",
    "diagnostic:run": "pnpm build:node && node dist-electron/src/scripts/run-diagnostic.js",
    "diagnostic:v5": "pnpm build:node && node dist-electron/src/scripts/run-v5-diagnostic.js",
    "benchmark:v5": "pnpm build:node && node dist-electron/src/scripts/benchmark-v5.js",
    "calibrate:v5": "pnpm build:node && node dist-electron/src/scripts/calibrate-v5-growth.js",
    "audit:v5": "pnpm build:node && node dist-electron/src/scripts/audit-v5-architecture.js",
    "report:v5:remediation": "pnpm build:node && node dist-electron/src/scripts/report-v5-remediation.js",
    "worksheet:v5:routes": "pnpm build:node && node dist-electron/src/scripts/generate-v5-route-worksheet.js",
    "accept:v5:route-classifications": "pnpm build:node && node dist-electron/src/scripts/accept-v5-route-classifications.js",
    "sync:v5:route-naming": "pnpm build:node && node dist-electron/src/scripts/sync-v5-route-classification-naming.js",
    "accept:v5:remediation": "pnpm build:node && node dist-electron/src/scripts/accept-v5-remediation.js",
    "verify:v5:replay": "pnpm build:node && node dist-electron/src/scripts/verify-v5-causal-replay.js",
    "accept:v5:prompt00": "pnpm build:node && node dist-electron/src/scripts/accept-v5-prompt00.js",
    "sweep:v5:migration-one-field": "pnpm build:node && node dist-electron/src/scripts/sweep-v5-migration-one-field.js",
    "validate:v5:migration-long-horizon": "pnpm build:node && node dist-electron/src/scripts/validate-v5-migration-long-horizon.js",
    "accept:v5:prompt01": "pnpm build:node && node dist-electron/src/scripts/accept-v5-prompt01.js",
    "accept:v5:prompt03": "pnpm build:node && node dist-electron/src/scripts/accept-v54-segmented.js",
    "accept:v54:segmented": "pnpm build:node && node dist-electron/src/scripts/accept-v54-segmented.js",
    "profile:v54:baseline": "pnpm build:node && node dist-electron/src/scripts/profile-v54-performance-baseline.js",
    "profile:v54:continuation": "pnpm build:node && node dist-electron/src/scripts/profile-v54-checkpoint-continuation.js",
    "audit:v54:event-volume": "pnpm build:node && node dist-electron/src/scripts/audit-v54-event-volume.js",
    "benchmark:v54:checkpoint-compression": "pnpm build:node && node dist-electron/src/scripts/benchmark-v54-checkpoint-compression.js",
    "diagnose:v54:breed-deity": "pnpm build:node && node dist-electron/src/scripts/diagnose-v54-breed-deity-authority.js",
    "artifacts:v54:correctness": "pnpm build:node && node dist-electron/src/scripts/generate-v54-correctness-artifacts.js",
    "artifacts:v54:evidence": "pnpm build:node && node dist-electron/src/scripts/generate-v54-remediation-evidence.js",
    "canonical:run": "pnpm build:node && node dist-electron/src/scripts/run-canonical.js",
    "storage:compact": "pnpm build:node && node dist-electron/src/scripts/compact-simulator-storage.js",
    "recover:v5:naming-batches": "pnpm build:node && node dist-electron/src/scripts/recover-v5-exported-naming-batches.js",
    "research:remediation": "pnpm build:node && node dist-electron/src/scripts/build-research-remediation.js",
    "research:v3": "pnpm build:node && node dist-electron/src/scripts/build-v3-research-complete.js",
    "research:v4:init": "pnpm build:node && node dist-electron/src/scripts/initialize-v4.js",
    "research:v4:personality-policy": "pnpm build:node && node dist-electron/src/scripts/author-personality-dimension-policy.js",
    "research:v4:batch": "pnpm build:node && node dist-electron/src/scripts/finalize-v4-batch.js",
    "research:v4:audit": "pnpm build:node && node dist-electron/src/scripts/run-v4-audit.js",
    "research:v4:consolidate": "pnpm build:node && node dist-electron/src/scripts/consolidate-v4.js",
    "research:v4:assess": "pnpm build:node && node dist-electron/src/scripts/assess-v4-authority.js",
    "research:v4:year0": "pnpm build:node && node dist-electron/src/scripts/verify-v4-year0.js",
    "research:v4:review-csv": "pnpm build:node && node dist-electron/src/scripts/export-v4-review-csv.js",
    "research:corpus:remediate": "pnpm build:node && node dist-electron/src/scripts/remediate-research-corpus.js",
    "research:corpus:import": "pnpm build:node && node dist-electron/src/scripts/import-research-corpus.js",
    "canonical:assemble": "pnpm research:v4:consolidate && pnpm research:v4:assess && pnpm research:v4:year0 && pnpm build:node && node dist-electron/src/scripts/assemble-canonical-bundle.js",
    "canonical:verify": "pnpm build:node && node dist-electron/src/scripts/verify-canonical-bundle.js",
    "canonical:refresh-integrity": "pnpm build:node && node dist-electron/src/scripts/refresh-canonical-integrity.js"
  },
  "dependencies": {
    "csv-parse": "6.2.1",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.echoesofeidolon.simulator",
    "productName": "Echoes of Eidolon Simulator",
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "simulator-resources"
      }
    ],
    "linux": {
      "target": "dir",
      "category": "Education"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
