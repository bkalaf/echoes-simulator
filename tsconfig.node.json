{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-electron",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts", "src/core/**/*.ts", "src/persistence/**/*.ts", "src/scripts/**/*.ts"]
}
