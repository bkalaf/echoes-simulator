{"batchId":"R02_B02","researchUnitId":"CLT_KIPCHAK_AND_NORTHERN_TURKIC","personalityId":"EXILE_NOMADIC_CONTINUITY_EXPRESSION","personalityBridge":"Eidolon-authored inference from a bounded historical pattern: the Qepcaq were a documented nomadic confederation whose union was broken by conquest, while constituent communities continued through later Central Asian and Volga-Ural peoples and polities. This maps documented nomadic continuity after political dispersal, not an inherent psychology of any modern Kipchak or Northern Turkic people.","inferenceClassification":"EIDOLON_AUTHORED_INFERENCE","terrainBroad":["GRASSLAND"],"terrainSpecific":["STEPPE"],"journalEntryIds":{"personalityId":"JRN_R02_B02_CLT_KIPCHAK_AND_NORTHERN_TURKIC_PERSONALITY_ID_001","terrainBroad":"JRN_R02_B02_CLT_KIPCHAK_AND_NORTHERN_TURKIC_TERRAIN_BROAD_001","terrainSpecific":"JRN_R02_B02_CLT_KIPCHAK_AND_NORTHERN_TURKIC_TERRAIN_SPECIFIC_001"},"status":"SIMULATION_READY"}
{"batchId":"R02_B02","researchUnitId":"CLT_MONGOL","personalityId":"COLLECTIVE_MEMORY_TECHNIQUE_TRADITION","personalityBridge":"Eidolon-authored inference from documented institutional and land-use continuity: UNESCO records persistent Mongolian nomadic pastoralism, seasonal transhumance, extensive trade networks, and administrative centers across the Orkhon landscape. This maps a maintained cultural technique and institutional tradition, not an inherent Mongol psychology.","inferenceClassification":"EIDOLON_AUTHORED_INFERENCE","terrainBroad":["GRASSLAND","FRESHWATER"],"terrainSpecific":["STEPPE","RIVER"],"journalEntryIds":{"personalityId":"JRN_R02_B02_CLT_MONGOL_PERSONALITY_ID_001","terrainBroad":"JRN_R02_B02_CLT_MONGOL_TERRAIN_BROAD_001","terrainSpecific":"JRN_R02_B02_CLT_MONGOL_TERRAIN_SPECIFIC_001"},"status":"SIMULATION_READY"}
{"batchId":"R02_B02","researchUnitId":"CLT_OGHUZ_TURKIC","personalityId":"EXILE_NOMADIC_CONTINUITY_EXPRESSION","personalityBridge":"Eidolon-authored inference from a bounded historical movement: the Oghuz were a named nomadic federation based around the Aral Sea and lower Syr Darya, portions of which moved under pressure into the Volga-Don region and Anatolia. This maps documented migration and nomadic continuity, not an inherent psychology of Oghuz-descended peoples.","inferenceClassification":"EIDOLON_AUTHORED_INFERENCE","terrainBroad":["GRASSLAND","FRESHWATER"],"terrainSpecific":["STEPPE","LAKE","RIVER"],"journalEntryIds":{"personalityId":"JRN_R02_B02_CLT_OGHUZ_TURKIC_PERSONALITY_ID_001","terrainBroad":"JRN_R02_B02_CLT_OGHUZ_TURKIC_TERRAIN_BROAD_001","terrainSpecific":"JRN_R02_B02_CLT_OGHUZ_TURKIC_TERRAIN_SPECIFIC_001"},"status":"SIMULATION_READY"}
{"batchId":"R02_B02","researchUnitId":"CLT_TAJIK_SOGDIAN","personalityId":"COLLECTIVE_MEMORY_TECHNIQUE_TRADITION","personalityBridge":"Eidolon-authored inference from documented Sogdian commercial and infrastructure practice: UNESCO records internationally active Sogdian merchants, maintained caravan facilities, irrigation systems, and a long-lived exchange corridor shared by Tajikistan and Uzbekistan. This maps evidenced institutional techniques and their historical record, not an inherent Tajik or Sogdian psychology.","inferenceClassification":"EIDOLON_AUTHORED_INFERENCE","terrainBroad":["MOUNTAIN","GRASSLAND","DESERT","FRESHWATER"],"terrainSpecific":["STEPPE","OASIS","RIVER"],"journalEntryIds":{"personalityId":"JRN_R02_B02_CLT_TAJIK_SOGDIAN_PERSONALITY_ID_001","terrainBroad":"JRN_R02_B02_CLT_TAJIK_SOGDIAN_TERRAIN_BROAD_001","terrainSpecific":"JRN_R02_B02_CLT_TAJIK_SOGDIAN_TERRAIN_SPECIFIC_001"},"status":"SIMULATION_READY"}
